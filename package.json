{
  "name": "mongosnooze",
  "version": "0.1.1",
  "description": "Lightweight, MongoDB-native delayed-job trigger using Change Streams and TTL wakeups. No Redis required.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mongodb",
    "delayed-jobs",
    "scheduler",
    "change-streams",
    "agenda",
    "bullmq",
    "background-jobs",
    "ttl",
    "typescript"
  ],
  "author": "Harsh0369",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Harsh0369/mongosnooze.git"
  },
  "homepage": "https://github.com/Harsh0369/mongosnooze#readme",
  "bugs": {
    "url": "https://github.com/Harsh0369/mongosnooze/issues"
  },
  "peerDependencies": {
    "mongodb": ">=5.0.0 <7.0.0"
  },
  "peerDependenciesMeta": {
    "mongodb": {
      "optional": false
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "mongodb": "^6.12.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
